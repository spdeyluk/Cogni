{
  "name": "cogni",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node scripts/build-web.js && node server.js",
    "build": "node scripts/build-web.js",
    "serve": "node server.js",
    "test": "node --test",
    "postinstall": "patch-package",
    "mobile:prepare": "node scripts/prepare-mobile.js",
    "ios:sync": "npm run mobile:prepare && npx cap sync ios",
    "ios:open": "npx cap open ios"
  },
  "dependencies": {
    "@capacitor-community/apple-sign-in": "^7.1.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/cli": "^8.4.0",
    "@capacitor/core": "^8.4.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.4.0",
    "@capacitor/local-notifications": "^8.2.1",
    "@supabase/supabase-js": "^2.110.8",
    "esbuild": "^0.28.0",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "patch-package": "^8.0.1"
  }
}
